#!/bin/zsh
set -euo pipefail

if [[ $# -ne 0 ]]; then
  print -u2 "Usage: ./scripts/goal"
  exit 64
fi

script_directory="${0:A:h}"
project_root="${script_directory:h}"
if [[ ! -f "${project_root}/project.yml" || ! -f "${project_root}/scripts/check" ]]; then
  print -u2 "Arrive Within product authority is incomplete."
  exit 66
fi

cd "$project_root"

# `scripts/check` is the implementation gate. This wrapper adds deterministic
# public-source identity without conflating local Git proof with an unauthorized
# remote publication or storefront claim.
./scripts/check
node scripts/test_prospective_public_manifest.mjs
node scripts/create_prospective_public_manifest.mjs

print "PASS Arrive Within offline Goal gate (deterministic public-source provenance)"
