#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
blueprint_root="${P0S_IOS_BLUEPRINT_ROOT:-$HOME/src/pg/ios-dev-blueprint}"
runner="$blueprint_root/scripts/verify.py"
profile="$repo_root/docs/qa/verification-profile.json"

if [[ ! -f "$runner" ]]; then
  echo "Shared verification runner missing; set P0S_IOS_BLUEPRINT_ROOT to an iOS Blueprint checkout." >&2
  exit 69
fi
exec python3 "$runner" --project "$repo_root" --profile "$profile" "$@"
